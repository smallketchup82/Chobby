 void CVerticalSync::SetInterval(int i)
 {
+	#ifdef MAC_EGL_BRIDGE_AVAILABLE
+	if (MacEGLBridge::Active()) {
+		// This port always presents through the synchronized Metal renderer.
+		configHandler->Set("VSync", i = 1);
+	}
+	#endif
